FROM python:3.11-slim

WORKDIR /app

# System build tools + fonts for Thai/CJK in matplotlib charts
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc \
    fonts-thai-tlwg fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies (cached layer — only re-runs when requirements.txt changes)
COPY requirements.txt ./
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# Copy source code (overridden by volume mount in docker-compose for dev hot reload)
COPY api/ ./api/

EXPOSE 8000

# Health check using Python stdlib
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# Start FastAPI with hot reload (file changes in mounted volume trigger restart)
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
