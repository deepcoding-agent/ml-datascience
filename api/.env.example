# PrepPilot backend env template.
# Copy to api/.env for local dev. In production set via `flyctl secrets set`.

# ── LLM providers ───────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override default models
OPENAI_MODEL=gpt-5.4-nano
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── CORS (production) ───────────────────────────────────────────────────────
# Comma-separated allowlist of frontend origins permitted to call the API.
# In dev, defaults to http://localhost:3000 if unset.
FRONTEND_ORIGIN=http://localhost:3000

# ── Storage ─────────────────────────────────────────────────────────────────
# Directory where trained .joblib model artefacts are written.
# Dev: leave unset to use ml-datascience/models/. Prod (Fly): /app/models (volume).
# MODELS_DIR=/app/models

# ── Sandbox ─────────────────────────────────────────────────────────────────
# Wall-clock timeout (seconds) for a single run_code() invocation.
SANDBOX_TIMEOUT_SECONDS=30
